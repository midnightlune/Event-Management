{
  "name": "event-ticket-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "node --env-file=.env.local scripts/setup-mysql.mjs",
    "db:passwords": "node --env-file=.env.local scripts/set-passwords.mjs",
    "mongo:seed": "node --env-file=.env.local scripts/seed-mongo.mjs",
    "setup:all": "npm run db:setup && npm run db:passwords && npm run db:roles && npm run mongo:seed",
    "db:roles": "node --env-file=.env.local scripts/setup-roles.mjs",
    "db:test": "node --env-file=.env.local scripts/test-db-security.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mongodb": "^6.8.0",
    "mysql2": "^3.11.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
