# Copy this file to .env.local and fill in your own values.
# .env.local is listed in .gitignore and must never be committed.

# --- MySQL administrator account: used ONLY by the setup scripts (npm run db:setup / db:roles) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ticketdb

# --- MySQL role accounts: the web app logs in with these, one per role (created by npm run db:roles) ---
# Choose a different strong password for each (avoid an unquoted # - it starts a comment in .env files).
# Account names are optional (defaults shown).
DB_ACCOUNT_HOST=localhost
DB_GUEST_USER=app_guest
DB_GUEST_PASSWORD=change-me-guest
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=change-me-auth
DB_CUSTOMER_USER=app_customer
DB_CUSTOMER_PASSWORD=change-me-customer
DB_ORGANIZER_USER=app_organizer
DB_ORGANIZER_PASSWORD=change-me-organizer
DB_ADMIN_USER=app_admin
DB_ADMIN_PASSWORD=change-me-admin
# Development shortcut: set to "off" to make the app use the single MYSQL_USER account for everything.
# DB_ROLE_ACCOUNTS=off

# --- MongoDB (MongoDB Compass uses the same connection string) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ticketdb

# --- Sessions: use a long random string (e.g. run: openssl rand -base64 32) ---
AUTH_SECRET=change-me-to-a-long-random-string
